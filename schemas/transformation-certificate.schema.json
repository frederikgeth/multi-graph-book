{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/frederikgeth/multi-graph-book/schemas/transformation-certificate.schema.json",
  "title": "Power-network transformation certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "certificate_id",
    "rule_id",
    "classification",
    "source",
    "target",
    "interfaces",
    "preconditions",
    "preserves",
    "forgets",
    "recovery_map",
    "constraint_map",
    "provenance",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "certificate_id": {"type": "string", "pattern": "^TR-[A-Z]+-[0-9]{3}$"},
    "rule_id": {"type": "string", "minLength": 1},
    "classification": {
      "enum": [
        "exact_normalization",
        "exact_compilation",
        "exact_behavioral_reduction",
        "inner_restriction",
        "outer_relaxation",
        "scenario_approximate",
        "mixed"
      ]
    },
    "source": {"$ref": "#/$defs/modelReference"},
    "target": {"$ref": "#/$defs/modelReference"},
    "interfaces": {"$ref": "#/$defs/interfaceContract"},
    "typed_interfaces": {"$ref": "#/$defs/typedInterfaceAttachment"},
    "preconditions": {"$ref": "#/$defs/uniqueStrings"},
    "preserves": {"$ref": "#/$defs/uniqueStrings"},
    "forgets": {"$ref": "#/$defs/uniqueStrings"},
    "recovery_map": {"type": "object", "additionalProperties": {"type": "string"}},
    "constraint_map": {"type": "object", "additionalProperties": {"type": "string"}},
    "provenance": {"type": "object"},
    "evidence": {"type": "object"},
    "numerical_evidence": {"$ref": "#/$defs/numericalEvidence"}
  },
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "interfaceMapping": {
      "type": "object",
      "required": ["source", "target", "relation"],
      "properties": {
        "source": {"$ref": "#/$defs/uniqueStrings"},
        "target": {"$ref": "#/$defs/uniqueStrings"},
        "relation": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "interfaceContract": {
      "type": "object",
      "required": [
        "state_variables",
        "constraints",
        "decisions",
        "objectives",
        "units",
        "boundary_quantities"
      ],
      "properties": {
        "state_variables": {"$ref": "#/$defs/interfaceMapping"},
        "constraints": {"$ref": "#/$defs/interfaceMapping"},
        "decisions": {"$ref": "#/$defs/interfaceMapping"},
        "objectives": {"$ref": "#/$defs/interfaceMapping"},
        "units": {"$ref": "#/$defs/interfaceMapping"},
        "boundary_quantities": {"$ref": "#/$defs/interfaceMapping"}
      },
      "additionalProperties": false
    },
    "typedInterfaceAttachment": {
      "type": "object",
      "required": [
        "state_space_ref",
        "source_variable_labels",
        "target_variable_labels",
        "source_unit_families",
        "target_unit_families",
        "unit_family_map",
        "unresolved_unit_labels",
        "source_boundary_labels",
        "target_boundary_labels",
        "state_domain_ids",
        "attachment_rule"
      ],
      "properties": {
        "state_space_ref": {"type": "string", "minLength": 1},
        "source_variable_labels": {"$ref": "#/$defs/uniqueStrings"},
        "target_variable_labels": {"$ref": "#/$defs/uniqueStrings"},
        "source_unit_families": {"$ref": "#/$defs/uniqueStrings"},
        "target_unit_families": {"$ref": "#/$defs/uniqueStrings"},
        "unit_family_map": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/uniqueStrings"}
        },
        "unresolved_unit_labels": {"$ref": "#/$defs/uniqueStrings"},
        "source_boundary_labels": {"$ref": "#/$defs/uniqueStrings"},
        "target_boundary_labels": {"$ref": "#/$defs/uniqueStrings"},
        "state_domain_ids": {"$ref": "#/$defs/uniqueStrings"},
        "attachment_rule": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "modelReference": {
      "type": "object",
      "required": ["model_category", "object_ids"],
      "properties": {
        "model_category": {"type": "string", "minLength": 1},
        "object_ids": {"$ref": "#/$defs/uniqueStrings"},
        "detail": {"type": "object"}
      },
      "additionalProperties": false
    },
    "numericalEvidence": {
      "type": "object",
      "required": [
        "solver_status",
        "optimality_status",
        "residual",
        "tolerance",
        "conditioning",
        "backward_error",
        "uncertainty_status"
      ],
      "properties": {
        "solver_status": {"type": "string", "minLength": 1},
        "optimality_status": {
          "enum": ["not_applicable", "not_assessed", "local", "branch_scoped", "global_certified"]
        },
        "residual": {"type": "number", "minimum": 0},
        "tolerance": {"type": "number", "exclusiveMinimum": 0},
        "conditioning": {"type": ["number", "null"], "minimum": 0},
        "backward_error": {"type": "number", "minimum": 0},
        "uncertainty_status": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
