{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-graph-book.example/schemas/llm-retrieval-benchmark.schema.json",
  "title": "Pinned neural LLM retrieval benchmark",
  "type": "object",
  "required": ["schema_version", "status", "corpus", "embedding_provenance", "inputs", "summary", "cases"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "status": {"enum": ["pass", "fail"]},
    "corpus": {"type": "object", "required": ["corpus_id", "corpus_sha256", "release"]},
    "embedding_provenance": {
      "type": "object",
      "required": [
        "provider", "model_id", "model_revision", "artifact_sha256",
        "artifact_hash_complete", "embedding_dimension", "sentence_transformers_version",
        "python_version"
      ],
      "properties": {
        "provider": {"const": "sentence-transformers"},
        "model_id": {"type": "string", "minLength": 1},
        "model_revision": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": ["string", "null"]},
        "artifact_hash_complete": {"type": "boolean"},
        "embedding_dimension": {"type": "integer", "minimum": 1},
        "sentence_transformers_version": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1}
      }
    },
    "inputs": {"type": "object"},
    "summary": {"type": "object", "required": ["cases", "lexical", "char_tfidf", "hybrid", "neural"]},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  },
  "additionalProperties": true
}
