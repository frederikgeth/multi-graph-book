{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-graph-book.example/schemas/agent-benchmark-pilot.schema.json",
  "title": "Scientifically constrained agent benchmark pilot design",
  "type": "object",
  "required": [
    "schema_version",
    "pilot_id",
    "benchmark_id",
    "status",
    "research_question",
    "active_conditions",
    "design",
    "system_slots",
    "sampling_settings",
    "budgets",
    "resource_bundles",
    "exclusion_rules",
    "aggregation",
    "human_review_gate",
    "dry_run_records",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "pilot_id": {"pattern": "^APILOT-[A-Z0-9-]+$"},
    "benchmark_id": {"pattern": "^ABENCH-[A-Z0-9-]+$"},
    "status": {"enum": ["design_complete_execution_not_authorized", "preregistered", "running", "complete"]},
    "active_conditions": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"pattern": "^C[0-9]+_[A-Z0-9_]+$"}
    },
    "design": {"type": "object"},
    "system_slots": {"type": "array", "minItems": 1},
    "sampling_settings": {"type": "object"},
    "budgets": {"type": "object"},
    "resource_bundles": {"type": "array", "minItems": 4},
    "exclusion_rules": {"type": "object"},
    "aggregation": {"type": "object"},
    "human_review_gate": {"type": "object"},
    "dry_run_records": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
