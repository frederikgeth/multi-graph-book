{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:multi-graph-book:schema:power-system-knowledge:0.1.0",
  "title": "Federated power-system knowledge record",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "record_type",
    "knowledge_id",
    "kind",
    "title",
    "scientific_statement",
    "scope",
    "evidence_status",
    "does_not_establish",
    "book",
    "executable",
    "source",
    "release",
    "text"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "record_id": {"type": "string", "pattern": "^knowledge:PSK-[0-9]{6}$"},
    "record_type": {"const": "scientific_knowledge"},
    "knowledge_id": {"type": "string", "pattern": "^PSK-[0-9]{6}$"},
    "kind": {
      "enum": [
        "misconception",
        "modelling-antipattern",
        "counterexample",
        "negative-result",
        "failure-mode",
        "invalid-inference",
        "numerical-pathology",
        "software-antipattern",
        "scope-boundary",
        "open-question"
      ]
    },
    "title": {"type": "string", "minLength": 1},
    "scientific_statement": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "evidence_status": {
      "enum": [
        "definition",
        "established_result",
        "empirical_result",
        "engineering_practice",
        "hypothesis",
        "conjecture",
        "open_question"
      ]
    },
    "does_not_establish": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "book": {
      "type": "object",
      "required": [
        "claim_ids",
        "misconception_ids",
        "certificate_ids",
        "counterexample_ids",
        "artifact_paths",
        "source_paths"
      ],
      "properties": {
        "claim_ids": {"$ref": "#/$defs/uniqueStrings"},
        "misconception_ids": {"$ref": "#/$defs/uniqueStrings"},
        "certificate_ids": {"$ref": "#/$defs/possiblyEmptyUniqueStrings"},
        "counterexample_ids": {"$ref": "#/$defs/possiblyEmptyUniqueStrings"},
        "artifact_paths": {"$ref": "#/$defs/uniqueStrings"},
        "source_paths": {"$ref": "#/$defs/uniqueStrings"}
      },
      "additionalProperties": false
    },
    "executable": {
      "type": "object",
      "required": [
        "implementation_status",
        "contract_ids",
        "finding_codes",
        "related_finding_codes",
        "fixture_ids"
      ],
      "properties": {
        "repository": {"const": "frederikgeth/BMOPFTools.jl"},
        "implementation_status": {"enum": ["planned", "partial", "implemented", "not_applicable"]},
        "contract_ids": {"$ref": "#/$defs/possiblyEmptyUniqueStrings"},
        "finding_codes": {"$ref": "#/$defs/possiblyEmptyUniqueStrings"},
        "related_finding_codes": {"$ref": "#/$defs/possiblyEmptyUniqueStrings"},
        "fixture_ids": {"$ref": "#/$defs/possiblyEmptyUniqueStrings"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"implementation_status": {"const": "not_applicable"}}},
          "then": {
            "not": {"required": ["repository"]},
            "properties": {
              "contract_ids": {"maxItems": 0},
              "finding_codes": {"maxItems": 0},
              "related_finding_codes": {"maxItems": 0},
              "fixture_ids": {"maxItems": 0}
            }
          },
          "else": {
            "required": ["repository"],
            "properties": {
              "contract_ids": {"minItems": 1},
              "finding_codes": {"minItems": 1},
              "fixture_ids": {"minItems": 1}
            }
          }
        }
      ]
    },
    "negative_result": {
      "type": "object",
      "required": [
        "question",
        "hypothesis",
        "motivation",
        "experimental_setup",
        "cases",
        "software_environment",
        "attempted_methods",
        "observed_result",
        "failure_criterion",
        "interpretation",
        "establishes",
        "conditions_might_work",
        "literature_keys",
        "reproducer_commands",
        "review_status"
      ],
      "properties": {
        "question": {"type": "string", "minLength": 1},
        "hypothesis": {"type": "string", "minLength": 1},
        "motivation": {"type": "string", "minLength": 1},
        "experimental_setup": {"type": "string", "minLength": 1},
        "cases": {"$ref": "#/$defs/uniqueStrings"},
        "software_environment": {"type": "string", "minLength": 1},
        "attempted_methods": {"$ref": "#/$defs/uniqueStrings"},
        "observed_result": {"type": "string", "minLength": 1},
        "failure_criterion": {"type": "string", "minLength": 1},
        "interpretation": {"type": "string", "minLength": 1},
        "establishes": {"$ref": "#/$defs/uniqueStrings"},
        "conditions_might_work": {"$ref": "#/$defs/uniqueStrings"},
        "literature_keys": {"$ref": "#/$defs/possiblyEmptyUniqueStrings"},
        "reproducer_commands": {"$ref": "#/$defs/uniqueStrings"},
        "review_status": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "numerical_pathology": {
      "type": "object",
      "required": [
        "phenomenon",
        "experimental_setup",
        "observed_behavior",
        "algorithmic_boundary",
        "invalid_inferences",
        "discriminating_checks",
        "conditions_might_change",
        "reproducer_commands",
        "review_status"
      ],
      "properties": {
        "phenomenon": {"type": "string", "minLength": 1},
        "experimental_setup": {"type": "string", "minLength": 1},
        "observed_behavior": {"type": "string", "minLength": 1},
        "algorithmic_boundary": {"type": "string", "minLength": 1},
        "invalid_inferences": {"$ref": "#/$defs/uniqueStrings"},
        "discriminating_checks": {"$ref": "#/$defs/uniqueStrings"},
        "conditions_might_change": {"$ref": "#/$defs/uniqueStrings"},
        "reproducer_commands": {"$ref": "#/$defs/uniqueStrings"},
        "review_status": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["repository", "path", "anchor", "sha256"],
      "properties": {
        "repository": {"const": "frederikgeth/multi-graph-book"},
        "path": {"const": "knowledge/psk.toml"},
        "anchor": {"type": "string", "pattern": "^PSK-[0-9]{6}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "release": {"type": "object"},
    "text": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "negative-result"}}},
      "then": {"required": ["negative_result"]},
      "else": {"not": {"required": ["negative_result"]}}
    },
    {
      "if": {"properties": {"kind": {"const": "numerical-pathology"}}},
      "then": {"required": ["numerical_pathology"]},
      "else": {"not": {"required": ["numerical_pathology"]}}
    }
  ],
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "possiblyEmptyUniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
