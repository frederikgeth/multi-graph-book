{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-graph-book.example/schemas/agent-benchmark-submission.schema.json",
  "title": "Scientifically constrained agent benchmark submission",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "run_id",
    "condition_id",
    "system",
    "provenance",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "benchmark_id": {"pattern": "^ABENCH-[A-Z0-9-]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "condition_id": {"pattern": "^C[0-9]+_[A-Z0-9_]+$"},
    "system": {
      "type": "object",
      "required": ["provider", "model_id", "model_revision"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "model_revision": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["federated_pair_id", "book_llm_corpus_sha256", "bmopftools_executable_corpus_sha256"],
      "properties": {
        "federated_pair_id": {"type": ["string", "null"]},
        "book_llm_corpus_sha256": {"type": ["string", "null"]},
        "bmopftools_executable_corpus_sha256": {"type": ["string", "null"]}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "action",
          "contract_status",
          "classification",
          "knowledge_ids",
          "finding_codes",
          "qualification_codes"
        ],
        "properties": {
          "action": {"enum": ["accept", "reject", "abstain"]},
          "contract_status": {"enum": ["passed", "failed", "inapplicable", "indeterminate"]},
          "classification": {"type": "string", "minLength": 1},
          "knowledge_ids": {"type": "array", "items": {"pattern": "^PSK-[0-9]{6}$"}},
          "finding_codes": {"type": "array", "items": {"type": "string"}},
          "qualification_codes": {"type": "array", "items": {"type": "string"}},
          "witness": {"type": "object"}
        }
      }
    }
  },
  "additionalProperties": false
}
