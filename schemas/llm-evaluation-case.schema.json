{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:multi-graph-book:schema:llm-evaluation-case:0.1.0",
  "title": "Book-grounded answer evaluation case",
  "type": "object",
  "required": [
    "case_id",
    "audience",
    "question",
    "misconception_id",
    "required_claim_ids",
    "required_concept_ids",
    "required_answer_elements",
    "forbidden_simplifications"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^EVAL-[A-Z0-9-]+$"},
    "audience": {"enum": ["student", "software_engineer", "power_engineer"]},
    "question": {"type": "string", "minLength": 10},
    "misconception_id": {"type": "string", "minLength": 1},
    "required_claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_concept_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_answer_elements": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "forbidden_simplifications": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
